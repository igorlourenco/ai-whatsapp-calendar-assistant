{
  "name": "ai-assistant-wpp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types",
    "eval": "tsx --env-file=.dev.vars scripts/eval.ts",
    "db": "tsx --env-file=.dev.vars scripts/db.ts",
    "configure": "tsx scripts/setup.ts",
    "connect-icloud": "tsx --env-file=.dev.vars scripts/connect-icloud.ts",
    "eval:images": "tsx --env-file=.dev.vars scripts/eval-images.ts",
    "eval:audio": "tsx --env-file=.dev.vars scripts/eval-audio.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "ical.js": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "^0.31.11",
    "sql.js": "^1.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  },
  "packageManager": "pnpm@10.28.2"
}
