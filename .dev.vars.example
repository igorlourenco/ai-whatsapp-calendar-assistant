# Copy to .dev.vars (git-ignored) or just run `pnpm configure`, which asks
# for anything missing, validates it and uploads it to Cloudflare.

# --- DeepSeek (platform.deepseek.com → API keys) -------------------------
DEEPSEEK_API_KEY=

# --- Z-API (app.z-api.io) -------------------------------------------------
# Instance ID + token from the instance page, Client-Token from Security.
# The instance can be shared with another use: only OWNER_PHONE is served.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Your WhatsApp number with country code. Only this number talks to the bot.
OWNER_PHONE=+55 11 91234 5678

# --- iCloud (events live in your Apple Calendar) --------------------------
# App-specific password: account.apple.com → Sign-In and Security →
# App-Specific Passwords. NOT your Apple ID password. Revocable anytime.
ICLOUD_USERNAME=you@icloud.com
ICLOUD_APP_PASSWORD=

# --- Settings (optional; defaults in src/worker/config.ts) -----------------
TIMEZONE=America/Sao_Paulo
MORNING_DIGEST_TIME=07:00
EVENING_DIGEST_TIME=21:00
DEFAULT_REMINDER_MINUTES=30
DEEPSEEK_MODEL=deepseek-flash
VISION_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
TASK_NAG_MINUTES=30
TASK_NAG_UNTIL=22:00

# --- Generated by `pnpm configure` if empty --------------------------------
# Secret in the webhook URL Z-API calls.
ZAPI_WEBHOOK_TOKEN=
# Bearer token for /debug/* (pnpm db: state, read-only SQL, backup, restore).
DEBUG_TOKEN=
# Your deployed worker URL (filled after the first deploy).
WORKER_URL=

# Multi-user: anyone who sends this code to the bot joins as a user, with
# their own agenda (stored in the bot, shown on their phone via an ICS link),
# tasks and shopping list. Letters/digits only, 4+ chars. Empty = nobody joins.
INVITE_CODE=
